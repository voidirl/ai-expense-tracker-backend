# Copy this file to .env and fill in real values before running docker-compose up

# Password for the PostgreSQL container's superuser. Used by both the `db` and
# `backend` services.
DB_PASSWORD=your_postgres_password_here

# Optional. Defaults to `postgres` when unset.
# DB_USER=postgres

# Only needed when running the backend directly (`./mvnw spring-boot:run`).
# The Compose stack sets these for you. application.properties has no defaults
# on purpose, so a misconfigured container fails fast instead of hanging on a
# localhost connection.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/expense_tracker
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_postgres_password_here

# Optional. Hibernate SQL logging, off by default so production logs stay quiet.
# SHOW_SQL=true